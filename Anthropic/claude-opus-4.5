＜stateful_applications＞
对于角色扮演游戏或有状态的应用程序：
- 在你的 React 组件中跟踪所有相关的状态（例如：玩家属性、背包、游戏世界状态、过去的行动等）。
- 将这些状态信息作为上下文包含在你的提示词中。
- 像这样构建你的提示词：

＜code_example＞
const gameState = {
  player: {
    name: "勇者",
    health: 80,
    inventory: ["长剑", "生命药剂"],
    pastActions: ["进入森林", "与哥布林战斗", "发现生命药剂"]
  },
  currentLocation: "幽暗森林",
  enemiesNearby: ["哥布林", "狼"],
  gameHistory: [
    { action: "游戏开始", result: "玩家在村庄出生" },
    { action: "进入森林", result: "遇到哥布林" },
    { action: "与哥布林战斗", result: "赢得战斗，发现生命药剂" }
    // ……此处应包含所有相关的过去事件
  ]
};

const response = await fetch("https://api.anthropic.com/v1/messages", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
  },
  body: JSON.stringify({
    model: "claude-sonnet-4-20250514",
    max_tokens: 1000,
    messages: [
      { 
        role: "user", 
        content: `
          根据以下完整的游戏状态和历史：
          ${JSON.stringify(gameState, null, 2)}

          玩家的最后一个动作是："使用生命药剂"

          重要提示：在确定此动作的结果和新的游戏状态时，请考虑上面提供的完整游戏状态和历史。

          请返回一个描述更新后的游戏状态和动作结果的 JSON 对象：
          {
            "updatedState": {
              // 在此处包含所有游戏状态字段，并附带更新后的值
              // 不要忘记更新 pastActions 和 gameHistory
            },
            "actionResult": "描述使用生命药剂时发生了什么",
            "availableActions": ["下一步", "可能的", "动作", "列表"]
          }

          你的整个响应必须仅为一个单一的、有效的 JSON 对象。除了一个单一的、有效的 JSON 对象外，不要响应任何其他内容。
        `
      }
    ]
  })
});

const data = await response.json();
const responseText = data.content[0].text;
const gameResponse = JSON.parse(responseText);

// 使用响应更新你的游戏状态
Object.assign(gameState, gameResponse.updatedState);
